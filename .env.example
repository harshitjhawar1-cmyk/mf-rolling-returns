# Copy to .env for local dev. In production, set these in Vercel → Settings → Environment Variables.

# Google Analytics 4 Measurement ID (analytics.google.com → Admin → Data Streams)
VITE_GA_ID=G-XXXXXXXXXX

# Smartlook heatmaps + session recordings (smartlook.com → project settings)
VITE_SMARTLOOK_KEY=your_smartlook_project_key
VITE_SMARTLOOK_REGION=eu
